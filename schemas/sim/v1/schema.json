{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:gargi-flow:schema:sim:v1",
  "title": "Gargi Flow Simulation Definition",
  "description": "Version 1 Simulation Definition Schema for Gargi Flow",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "apiVersion",
    "id",
    "graph",
    "worlds",
    "objective"
  ],
  "properties": {
    "apiVersion": {
      "const": "sim/v1",
      "description": "API Version for the simulation schema definition"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9_-]+$",
      "description": "The unique identifier of the simulation definition"
    },
    "graph": {
      "type": "string",
      "description": "Path relative to the sim file"
    },
    "worlds": {
      "type": "object",
      "additionalProperties": false,
      "patternProperties": {
        "^[a-zA-Z0-9_-]+$": {
          "type": "object",
          "additionalProperties": {
            "type": [
              "number",
              "string",
              "boolean"
            ]
          }
        }
      },
      "minProperties": 1,
      "description": "Map name -> params map, min 1"
    },
    "latents": {
      "type": "object",
      "additionalProperties": false,
      "patternProperties": {
        "^[a-zA-Z0-9_-]+$": {
          "$ref": "#/$defs/ValueSpec"
        }
      }
    },
    "behaviors": {
      "type": "object",
      "additionalProperties": false,
      "patternProperties": {
        "^[a-zA-Z0-9_-]+$": {
          "$ref": "#/$defs/Behavior"
        }
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "patternProperties": {
        "^[a-zA-Z0-9_-]+$": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "capacity": {
              "type": "integer"
            }
          },
          "required": [
            "capacity"
          ]
        }
      }
    },
    "objective": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "value": {
          "type": "string"
        },
        "maximize": {
          "type": "string",
          "enum": [
            "mean"
          ]
        },
        "constraints": {
          "type": "object",
          "additionalProperties": false,
          "patternProperties": {
            "^[a-zA-Z0-9_-]+$": {
              "type": "string"
            }
          },
          "description": "Map name -> per-run boolean CEL expression; estimates report the probability that each holds"
        },
        "requirements": {
          "type": "object",
          "additionalProperties": false,
          "patternProperties": {
            "^[a-zA-Z0-9_-]+$": {
              "type": "string",
              "pattern": "^\\s*((mean|p50|p95)\\(\\s*[a-z_][a-z0-9_]*\\s*\\)|prob\\(.+\\))\\s*(<=|<|>=|>|==)\\s*\\S.*$"
            }
          },
          "description": "Map name -> aggregate requirement '<agg>(<arg>) <op> <rhs>' evaluated on the estimates of each policy in each world: agg is mean, p50 or p95 of a metric (objective, cost, duration or a declared metric) or prob(<per-run boolean CEL>); op is <=, <, >=, > or ==; rhs is a number or duration('<Go duration>') in seconds. Policies that violate a requirement are infeasible and rank last"
        }
      },
      "required": [
        "name",
        "value",
        "maximize"
      ]
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "patternProperties": {
        "^[a-z_][a-z0-9_]*$": {
          "type": "string"
        }
      },
      "description": "Map name -> numeric CEL expression evaluated once per run with world, latent, nodes and run, estimated like the objective. objective, cost and duration are reserved built-in metrics"
    },
    "arrivals": {
      "$ref": "#/$defs/ArrivalsSpec"
    },
    "horizon": {
      "type": "string",
      "pattern": "^[0-9]+(ms|s|m|h)$"
    }
  },
  "$defs": {
    "NumberOrCEL": {
      "type": [
        "number",
        "string"
      ]
    },
    "ValueSpec": {
      "type": "object",
      "oneOf": [
        {
          "required": [
            "fixed"
          ],
          "properties": {
            "fixed": {
              "$ref": "#/$defs/NumberOrCEL"
            }
          }
        },
        {
          "required": [
            "choice"
          ],
          "properties": {
            "choice": {
              "type": "object",
              "additionalProperties": false,
              "patternProperties": {
                "^[a-zA-Z0-9_-]+$": {
                  "$ref": "#/$defs/NumberOrCEL"
                }
              }
            }
          }
        },
        {
          "required": [
            "bernoulli"
          ],
          "properties": {
            "bernoulli": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "p": {
                  "$ref": "#/$defs/NumberOrCEL"
                }
              },
              "required": [
                "p"
              ]
            }
          }
        },
        {
          "required": [
            "normal"
          ],
          "properties": {
            "normal": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "mean": {
                  "$ref": "#/$defs/NumberOrCEL"
                },
                "sd": {
                  "$ref": "#/$defs/NumberOrCEL"
                }
              },
              "required": [
                "mean",
                "sd"
              ]
            }
          }
        },
        {
          "required": [
            "lognormal"
          ],
          "properties": {
            "lognormal": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "mu": {
                  "$ref": "#/$defs/NumberOrCEL"
                },
                "sigma": {
                  "$ref": "#/$defs/NumberOrCEL"
                }
              },
              "required": [
                "mu",
                "sigma"
              ]
            }
          }
        },
        {
          "required": [
            "uniform"
          ],
          "properties": {
            "uniform": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "min": {
                  "$ref": "#/$defs/NumberOrCEL"
                },
                "max": {
                  "$ref": "#/$defs/NumberOrCEL"
                }
              },
              "required": [
                "min",
                "max"
              ]
            }
          }
        },
        {
          "required": [
            "triangular"
          ],
          "properties": {
            "triangular": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "min": {
                  "$ref": "#/$defs/NumberOrCEL"
                },
                "mode": {
                  "$ref": "#/$defs/NumberOrCEL"
                },
                "max": {
                  "$ref": "#/$defs/NumberOrCEL"
                }
              },
              "required": [
                "min",
                "mode",
                "max"
              ]
            }
          }
        },
        {
          "required": [
            "exponential"
          ],
          "properties": {
            "exponential": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "rate": {
                  "$ref": "#/$defs/NumberOrCEL"
                }
              },
              "required": [
                "rate"
              ]
            }
          }
        },
        {
          "required": [
            "empirical"
          ],
          "properties": {
            "empirical": {
              "type": "array",
              "items": {
                "type": "number"
              }
            }
          }
        },
        {
          "required": [
            "expr"
          ],
          "properties": {
            "expr": {
              "type": "string"
            }
          }
        }
      ]
    },
    "Behavior": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "cost": {
          "$ref": "#/$defs/NumberOrCEL"
        },
        "duration": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^[0-9]+(ms|s|m|h)$"
            },
            {
              "$ref": "#/$defs/ValueSpec"
            }
          ]
        },
        "abandon": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "p": {
              "$ref": "#/$defs/NumberOrCEL"
            }
          },
          "required": [
            "p"
          ]
        },
        "fail": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "p": {
              "$ref": "#/$defs/NumberOrCEL"
            },
            "class": {
              "type": "string",
              "enum": [
                "retryable",
                "non_retryable",
                "critical"
              ]
            }
          },
          "required": [
            "p",
            "class"
          ]
        },
        "output": {
          "type": "object",
          "additionalProperties": false,
          "patternProperties": {
            "^[a-zA-Z0-9_-]+$": {
              "$ref": "#/$defs/ValueSpec"
            }
          }
        },
        "resource": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_-]+$"
        },
        "patience": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^[0-9]+(ms|s|m|h)$"
            },
            {
              "$ref": "#/$defs/NumberOrCEL"
            }
          ]
        },
        "agent": {
          "$ref": "#/$defs/AgentConfig"
        }
      }
    },
    "AgentConfig": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "endpoint": {
          "type": "string",
          "format": "uri"
        },
        "model": {
          "type": "string"
        },
        "system_prompt": {
          "type": "string"
        },
        "headers": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "timeout": {
          "type": "string"
        },
        "max_requests": {
          "type": "integer",
          "minimum": 1
        },
        "max_cost": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      },
      "required": [
        "endpoint"
      ]
    },
    "ArrivalsSpec": {
      "type": "object",
      "additionalProperties": false,
      "oneOf": [
        {
          "required": [
            "poisson"
          ],
          "properties": {
            "poisson": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "rate": {
                  "$ref": "#/$defs/NumberOrCEL"
                }
              },
              "required": [
                "rate"
              ]
            }
          }
        },
        {
          "required": [
            "schedule"
          ],
          "properties": {
            "schedule": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "duration": {
                    "type": "string",
                    "pattern": "^[0-9]+(ms|s|m|h)$"
                  },
                  "rate": {
                    "$ref": "#/$defs/NumberOrCEL"
                  }
                },
                "required": [
                  "duration",
                  "rate"
                ]
              }
            }
          }
        },
        {
          "required": [
            "empirical"
          ],
          "properties": {
            "empirical": {
              "type": "array",
              "items": {
                "type": "number"
              }
            }
          }
        }
      ]
    }
  }
}
