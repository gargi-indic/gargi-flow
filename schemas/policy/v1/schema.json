{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:gargi-flow:schema:policy:v1",
  "title": "Gargi Flow Policy Definition",
  "description": "Version 1 Policy Definition Schema for Gargi Flow",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "apiVersion",
    "id",
    "version",
    "decisions"
  ],
  "properties": {
    "apiVersion": {
      "const": "policy/v1",
      "description": "API Version for the policy schema definition"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9_-]+$"
    },
    "version": {
      "type": "string"
    },
    "params": {
      "type": "object",
      "description": "Tunable parameters, referenced as params.<name> in rule when expressions. Each is a range (min, max, optional step) or a values list; grid and random search vary them",
      "additionalProperties": false,
      "patternProperties": {
        "^[a-z_][a-z0-9_]*$": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "min": {
              "type": "number",
              "description": "Lower bound of a range param (inclusive)"
            },
            "max": {
              "type": "number",
              "description": "Upper bound of a range param (inclusive), >= min"
            },
            "step": {
              "type": "number",
              "exclusiveMinimum": 0,
              "description": "Grid spacing of a range param; required by grid search"
            },
            "values": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": [
                  "number",
                  "string"
                ]
              },
              "description": "Admissible values of a values-list param"
            },
            "default": {
              "type": [
                "number",
                "string"
              ],
              "description": "Initially bound value; defaults to min (range) or values[0]"
            }
          },
          "oneOf": [
            {
              "required": [
                "min",
                "max"
              ],
              "not": {
                "required": [
                  "values"
                ]
              }
            },
            {
              "required": [
                "values"
              ],
              "not": {
                "anyOf": [
                  {
                    "required": [
                      "min"
                    ]
                  },
                  {
                    "required": [
                      "max"
                    ]
                  },
                  {
                    "required": [
                      "step"
                    ]
                  }
                ]
              }
            }
          ]
        }
      }
    },
    "decisions": {
      "type": "object",
      "additionalProperties": false,
      "patternProperties": {
        "^[a-zA-Z0-9_-]+$": {
          "type": "object",
          "oneOf": [
            {
              "required": [
                "rules"
              ],
              "properties": {
                "rules": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "oneOf": [
                      {
                        "required": [
                          "when",
                          "choose"
                        ],
                        "properties": {
                          "when": {
                            "type": "string"
                          },
                          "choose": {
                            "type": "string"
                          }
                        }
                      },
                      {
                        "required": [
                          "else"
                        ],
                        "properties": {
                          "else": {
                            "type": "string"
                          }
                        }
                      }
                    ]
                  }
                }
              }
            },
            {
              "required": [
                "table",
                "default"
              ],
              "properties": {
                "table": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "observed": {
                        "type": "object",
                        "additionalProperties": false,
                        "patternProperties": {
                          "^[a-zA-Z0-9_\\.-]+$": {
                            "type": [
                              "string",
                              "number",
                              "boolean"
                            ]
                          }
                        }
                      },
                      "choose": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "observed",
                      "choose"
                    ]
                  }
                },
                "default": {
                  "type": "string"
                }
              }
            },
            {
              "required": [
                "agent"
              ],
              "properties": {
                "agent": {
                  "$ref": "#/$defs/AgentConfig"
                }
              }
            }
          ]
        }
      }
    }
  },
  "$defs": {
    "AgentConfig": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "endpoint": {
          "type": "string",
          "format": "uri"
        },
        "model": {
          "type": "string"
        },
        "system_prompt": {
          "type": "string"
        },
        "headers": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "timeout": {
          "type": "string"
        },
        "max_requests": {
          "type": "integer",
          "minimum": 1
        },
        "max_cost": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      },
      "required": [
        "endpoint"
      ]
    }
  }
}
